# PhpStorm HTTP Client — streetcat API
# 준비: docs/SETUP_STREETCAT.md 참고.
# streetcat DB 준비 후 php artisan project:migrate streetcat / project:create streetcat
# .env: APP_ENV=local, PLATFORM_SMS_DRIVER=preview, APP_KEY/JWT_SECRET 설정.
# baseUrl 수정 후 01~13 순서대로 실행. 03~06은 3분 이내에 실행하세요.
# 재실행은 같은 번호로 60초 대기, 3시간 내 발급 최대 5회.
# 현재 운영 SMS 미연결: production에서는 발급 503.
# 로그아웃 검증은 JWT_BLACKLIST_ENABLED=true와 영속 캐시가 필요합니다.
# 기존 HTTP Client 전역 Authorization 설정은 해제하세요.

@baseUrl = http://220.118.162.20:8000
@project = streetcat
@phone = 01012345678

### 01. 서버 상태 — 200
GET {{baseUrl}}/up
Accept: application/json

> {%
    client.test("서버 상태", function () {
        client.assert(response.status === 200, "Expected 200");
    });
%}

### 02. 비로그인 내 정보 접근 차단 — 401 (Authorization 헤더 없음)
GET {{baseUrl}}/api/v1/projects/{{project}}/me
Accept: application/json

> {%
    client.test("로그인 필요", function () {
        client.assert(response.status === 401, "Expected 401");
    });
%}

### 03. 인증번호 요청 — 201, challenge/code 자동 저장 (개발 환경 전용)
< {%
    client.global.clear("sc_challenge");
    client.global.clear("sc_code");
    client.global.clear("sc_token");
    client.global.clear("sc_account_id");
    client.global.clear("sc_project_id");
%}
POST {{baseUrl}}/api/v1/projects/{{project}}/auth/phone/request
Accept: application/json
Content-Type: application/json

{"phone": "{{phone}}"}

> {%
    if (response.status === 201 && response.body.data) {
        client.global.set("sc_challenge", response.body.data.challenge_id);
        if (response.body.data.development_code) {
            client.global.set("sc_code", response.body.data.development_code);
        }
    }
    client.test("개발용 인증번호 발급", function () {
        client.assert(response.status === 201, "Expected 201; 429=재요청 제한, 503=preview 설정 확인");
        client.assert(!!client.global.get("sc_code"), "APP_ENV=local / PLATFORM_SMS_DRIVER=preview 필요");
    });
%}

### 04. 같은 인증 요청 연속 발급 차단 — 429 (03 실행 후 60초 이내)
POST {{baseUrl}}/api/v1/projects/{{project}}/auth/phone/request
Accept: application/json
Content-Type: application/json

{"phone": "{{phone}}"}

> {%
    client.test("60초 재발급 제한", function () {
        client.assert(response.status === 429, "Expected 429; 03 직후 실행하세요");
    });
%}

### 05. 인증 후 자동 가입/로그인 — 200, JWT/회원 ID 자동 저장 (03 이후 3분 이내)
POST {{baseUrl}}/api/v1/projects/{{project}}/auth/phone/verify
Accept: application/json
Content-Type: application/json

{"challenge_id": "{{sc_challenge}}", "code": "{{sc_code}}"}

> {%
    if (response.status === 200 && response.body.data) {
        const data = response.body.data;
        client.global.set("sc_token", data.access_token);
        client.global.set("sc_account_id", String(data.account.id));
        client.global.set("sc_project_id", String(data.account.project_id));
    }
    client.test("로그인 및 프로젝트 계정 발급", function () {
        client.assert(response.status === 200, "Expected 200; 인증번호 만료/재사용 확인");
        client.assert(!!client.global.get("sc_token"), "JWT가 필요합니다");
    });
%}

### 06. 인증번호 재사용 차단 — 422
POST {{baseUrl}}/api/v1/projects/{{project}}/auth/phone/verify
Accept: application/json
Content-Type: application/json

{"challenge_id": "{{sc_challenge}}", "code": "{{sc_code}}"}

> {%
    client.test("일회용 인증번호", function () {
        client.assert(response.status === 422, "Expected 422");
    });
%}

### 07. 내 정보 — 200
GET {{baseUrl}}/api/v1/projects/{{project}}/me
Accept: application/json
Authorization: Bearer {{sc_token}}

> {%
    client.test("내 계정 조회", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(String(response.body.data.id) === client.global.get("sc_account_id"), "회원 ID 일치");
        client.assert(response.body.data.phone === undefined, "전화번호는 응답에서 숨겨야 합니다");
    });
%}

### 08. 내 프로필 수정 — 200 (테스트 계정의 표시 이름을 변경합니다)
PATCH {{baseUrl}}/api/v1/projects/{{project}}/me
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{sc_token}}

{"display_name": "돌봄 테스트"}

> {%
    client.test("프로필 수정", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.data.display_name === "돌봄 테스트", "표시 이름 저장 확인");
    });
%}

### 09. 본문으로 프로젝트 덮어쓰기 차단 — 422
PATCH {{baseUrl}}/api/v1/projects/{{project}}/me
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{sc_token}}

{"project_id": 999999, "display_name": "저장되면 안 됨"}

> {%
    client.test("프로젝트 파라미터 거부", function () {
        client.assert(response.status === 422, "Expected 422");
    });
%}

### 10. 로그아웃 — 204 (JWT 폐기)
POST {{baseUrl}}/api/v1/projects/{{project}}/auth/logout
Accept: application/json
Authorization: Bearer {{sc_token}}

> {%
    client.test("로그아웃", function () {
        client.assert(response.status === 204, "Expected 204");
    });
%}

### 11. 로그아웃한 JWT 재사용 차단 — 401
GET {{baseUrl}}/api/v1/projects/{{project}}/me
Accept: application/json
Authorization: Bearer {{sc_token}}

> {%
    client.test("폐기된 JWT 거부", function () {
        client.assert(response.status === 401, "Expected 401; JWT blacklist와 영속 캐시 설정 확인");
    });
%}



### 12. 미등록 프로젝트 차단 — 404 (별도 앱 등록 불필요)
GET {{baseUrl}}/api/v1/projects/not-registered/me
Accept: application/json

> {%
    client.test("미등록 프로젝트 거부", function () {
        client.assert(response.status === 404, "Expected 404");
    });
%}

### 13. DB 선택 파라미터 차단 — 422
POST {{baseUrl}}/api/v1/projects/{{project}}/auth/phone/request
Accept: application/json
Content-Type: application/json

{"phone": "{{phone}}", "database": "other_app"}

> {%
    client.test("클라이언트 DB 선택 거부", function () {
        client.assert(response.status === 422, "Expected 422");
    });
%}
