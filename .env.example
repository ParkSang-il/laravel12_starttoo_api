APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Phone verification mode (server-controlled; Flutter follows the response):
# preview  = numeric code shown in the debug app; no SMS/Octomo request.
#            Requires APP_ENV=local or testing on an isolated test server.
# octomo   = user sends an SMS; requires OCTOMO_API_KEY below.
# disabled = stop all new phone authentication requests (does not enable preview).
# Emulator example: APP_ENV=local + PLATFORM_SMS_DRIVER=preview.
# Real SMS example: PLATFORM_SMS_DRIVER=octomo + OCTOMO_API_KEY=<server-only key>.
# Run `php artisan optimize:clear` after changing the server .env.
PLATFORM_SMS_DRIVER=disabled
OCTOMO_API_KEY=

# FCM credentials are mounted read-only into chat-queue-rt, never into the app.
STREETCAT_PUSH_ENABLED=false
STREETCAT_FCM_CREDENTIALS=/run/secrets/streetcat-fcm.json
STARTTOO_PUSH_ENABLED=false
STARTTOO_MARKETING_PUSH_ENABLED=false
STARTTOO_FCM_CREDENTIALS=/run/secrets/starttoo/fcm.json
STARTTOO_FIREBASE_PROJECT_ID=starttoo-edd0b
# STARTTOO_FCM_HOST_DIR=/home/docker/secrets/starttoo
# STREETCAT_FCM_HOST_PATH=/path/outside/git/streetcat-fcm.json

# 별도 설정이 없으면 기존 DB_HOST/PORT/USERNAME/PASSWORD를 사용한다.
# STARTTOO 전용 연결에서는 DB_URL을 사용하지 않는다.
STARTTOO_DB_DATABASE=starttoo
# STARTTOO_DB_HOST=
# STARTTOO_DB_PORT=3306
# STARTTOO_DB_USERNAME=
# STARTTOO_DB_PASSWORD=

# 개발용 약관 초안 테스트 환경에서만 활성화한다.
STARTTOO_DRAFT_TERMS_ENABLED=false
STARTTOO_GUEST_BROWSING_ENABLED=false

# STARTTOO 사진 전용 버킷. 자격 증명·리전·엔드포인트는 기본 AWS_* 값을 사용한다.
STARTTOO_AWS_BUCKET=starttoo
# Image Optimizer 기준 주소. starttoo 버킷에 연결하고 가로 300/500 규칙을 등록한다.
STARTTOO_CDN_URL=https://6n86dw2k13558.edge.naverncp.com
# STARTTOO_AWS_ACCESS_KEY_ID=
# STARTTOO_AWS_SECRET_ACCESS_KEY=
# STARTTOO_AWS_DEFAULT_REGION=
# STARTTOO_AWS_ENDPOINT=
