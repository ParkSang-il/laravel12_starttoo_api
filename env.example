# Same settings as .env.example; prefer .env.example for new installations.
APP_NAME="Project API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ko
APP_FALLBACK_LOCALE=en

# Default connection is infrastructure/legacy only. App models never fall back to it.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=starttoo
DB_USERNAME=starttoo
DB_PASSWORD=

# streetcat app database and dedicated account. Inside Docker DB_HOST is usually mysql.
STREETCAT_DB_HOST=127.0.0.1
STREETCAT_DB_PORT=3306
STREETCAT_DB_DATABASE=streetcat
STREETCAT_DB_USERNAME=streetcat
STREETCAT_DB_PASSWORD=
# STREETCAT_MYSQL_SSL_CA=

JWT_SECRET=
JWT_TTL=60
JWT_BLACKLIST_ENABLED=true
# Only for local/testing; actual SMS provider is not implemented yet.
PLATFORM_SMS_DRIVER=disabled
PLATFORM_DAILY_SMS_LIMIT=1000

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=info

# For multi-instance production use a shared persistent cache, e.g. CACHE_STORE=redis.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1
MAIL_MAILER=log
